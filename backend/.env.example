DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/kochwiki
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,[::1],[::1]:*,backend,backend:*
OPENAI_API_KEY=xxxx
EMBEDDING_MODEL=text-embedding-3-large

OIDC_ISSUER=
OIDC_CLIENT_ID=kochwiki
OIDC_CLIENT_SECRET=
OIDC_CALLBACK_URL=
# Docker backend only; omit for a backend running directly on the host:
OIDC_BACKCHANNEL_URL=
# Temporary HTTP deployments only; disable once TLS is configured.
OIDC_ALLOW_INSECURE_HTTP=false

# Optional storage: configure all seven values together to enable it.
# The internal endpoint must be reachable from the backend process.
# STORAGE_ENDPOINT_URL=http://file-storage:3900
# STORAGE_PUBLIC_ORIGIN=http://localhost:8000
# STORAGE_REGION=garage
# STORAGE_BUCKET_RECIPE_IMAGES=recipe-images
# STORAGE_BUCKET_FOODSTUFF_IMAGES=foodstuff-images
# STORAGE_ACCESS_KEY_ID=xxxx
# STORAGE_SECRET_ACCESS_KEY=xxxx
