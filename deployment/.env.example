GATEWAY_PORT=8000
# Public application origin only; required for staging/production, local defaults to http://localhost:${GATEWAY_PORT}.
STORAGE_PUBLIC_ORIGIN=

GARAGE_RPC_SECRET=xxxx
GARAGE_ADMIN_TOKEN=
# Shared application credentials for the recipe-images and foodstuff-images buckets.
GARAGE_ACCESS_KEY_ID=xxxx
GARAGE_SECRET_ACCESS_KEY=xxxx

AI_GATEWAY_URL=http://host.docker.internal:8000
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,[::1],[::1]:*,backend,backend:*

OPENAI_API_KEY=xxxx
EMBEDDING_MODEL=text-embedding-3-large

APP_DB_NAME=kochwiki
APP_DB_USER=kochwiki
APP_DB_PASSWORD=xxxx

POSTGRES_PASSWORD=xxxx

OIDC_ISSUER=
OIDC_CLIENT_ID=kochwiki
OIDC_CLIENT_SECRET=
OIDC_CALLBACK_URL=
# Docker backend only; omit for a backend running directly on the host:
OIDC_BACKCHANNEL_URL=
