{
  "name": "angular",
  "version": "v0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run prebuild && ng serve --port 4202",
    "prebuild": "node generate-version.js",
    "build": "ng build",
    "generate:kochwiki-contract": "node scripts/kochwiki-contract.mjs",
    "check:kochwiki-contract": "node scripts/kochwiki-contract.mjs --check",
    "watch": "ng build --watch --configuration development",
    "link:chat-ui": "npm link ../../ai-service/frontend/dist/chat-ui",
    "test": "node scripts/test.mts",
    "test:browser": "node scripts/test.mts --configuration browser --watch=false",
    "test:tooling": "node --test ../.agents/validation/shared.test.mts ../.agents/validation/frontend.test.mts ../.agents/validation/e2e.test.mts ../.codex/validate.test.mts",
    "format:changed": "node ../.agents/validation/frontend.mts --format",
    "lint": "eslint . ../.agents/validation ../.codex --max-warnings=0",
    "lint:fix": "eslint . ../.agents/validation ../.codex --max-warnings=0 --fix",
    "test:e2e": "node ../.agents/validation/e2e.mts",
    "test:e2e:browser": "playwright test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.6",
    "@angular/cdk": "^22.1.6",
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/material": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/platform-browser-dynamic": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@roithme0/chat-ui": "0.9.0",
    "angular": "file:",
    "chart.js": "^4.5.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "4.4.3",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@vitest/browser-playwright": "4.1.11",
    "angular-eslint": "22.6.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "^30.0.1",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.11"
  }
}
