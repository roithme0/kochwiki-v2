{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Code/kochwiki-v2/.codex/validate.mts --start",
            "timeout": 30,
            "statusMessage": "Recording validation inputs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Code/kochwiki-v2/.codex/validate.mts --stop",
            "timeout": 2400,
            "statusMessage": "Formatting changed files and validating frontend, backend, and isolated E2E"
          }
        ]
      }
    ]
  }
}
